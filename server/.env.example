# ---- CMI server configuration ----------------------------------------------
PORT=3001

# Anthropic credentials. When set, agent runs are planned and executed by Claude
# through the governed MCP tools. When unset, the deterministic simulated planner
# is used (same tools, same guardrails, same audit trail).
# ANTHROPIC_API_KEY=sk-ant-...

# Payouts above this USD amount require a human checkpoint when initiated by an agent.
CMI_PAYMENT_THRESHOLD=1000

# Secret used to sign dashboard session tokens.
CMI_AUTH_SECRET=change-me-in-production

# Default agent session used by MCP clients that do not pass one
# (stdio: CMI_SESSION_ID env; HTTP: X-CMI-Session header).
CMI_SESSION_ID=sess_techpulse_operator

# SQLite file location (default: server/data/cmi.db). Use ":memory:" for ephemeral.
# CMI_DB_PATH=./data/cmi.db

# Set to "false" to skip automatic seeding of an empty database on boot.
CMI_AUTO_SEED=true

# Max model turns per agent run and simulated planner pacing (ms between steps).
CMI_AGENT_MAX_TURNS=24
CMI_SIM_PACE_MS=350
